          "name": "LinkedIn Opt Out Member from Compliance Monitoring",
          "request": {
            "name": "LinkedIn Opt Out Member from Compliance Monitoring",
            "description": {
              "content": "Opt out a member from being regulated on LinkedIn. A member will not opt out due to access token expiration. Opt out occurs when the application invokes this DELETE API or the member removes authorization through LinkedIn's Privacy Settings.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "memberComplianceAuthorizations",

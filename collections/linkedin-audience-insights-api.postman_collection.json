              "raw": "{\n  \"request\": {\n    \"targetingCriteria\": {\n      \"include\": {\n        \"and\": [\n          {\n            \"or\": {\n              \"key_0\": [\n                \"<string>\",\n                \"<string>\"\n              ],\n              \"key_1\": [\n                \"<string>\",\n                \"<string>\"\n              ]\n            }\n          },\n          {\n            \"or\": {\n              \"key_0\": [\n                \"<string>\",\n                \"<string>\"\n              ],\n              \"key_1\": [\n                \"<string>\",\n                \"<string>\"\n              ]\n            }\n          }\n        ]\n      }\n    },\n    \"groupBy\": \"<string>\",\n    \"requestMetaData\": {\n      \"sponsoredAccount\": \"<string>\"\n    }\n  }\n}",

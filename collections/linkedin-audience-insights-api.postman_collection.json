          "request": {
            "name": "LinkedIn Fetch Audience Insights by Targeting Criteria",
            "description": {
              "content": "Retrieve aggregated demographic insights, firmographic details, locations, and interests/behaviors for a target audience based on specified targeting criteria.",
              "type": "text/plain"
            },

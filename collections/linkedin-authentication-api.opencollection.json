{
  "opencollection": "1.0.0",
  "info": {
    "name": "LinkedIn Compliance Events Access Control Authentication API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://www.linkedin.com/oauth/v2/authorization",
      "accessTokenUrl": "https://www.linkedin.com/oauth/v2/accessToken",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "LinkedIn Get Customer Application Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.linkedin.com/oauth/v2/accessToken",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": []
            }
          },
          "docs": "Obtains an OAuth 2.0 access token using client credentials grant for customer application authentication."
        }
      ]
    }
  ],
  "bundled": true
}
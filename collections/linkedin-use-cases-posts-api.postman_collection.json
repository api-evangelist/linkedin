        {
          "id": "146c07ab-856c-4cac-83f1-58915e7e22b9",
          "name": "LinkedIn Update a Post",
          "request": {
            "name": "LinkedIn Update a Post",
            "description": {
              "content": "The following `posts` field are available to update. Refer to [Schema](https://docs.microsoft.com/en-us/linkedin/marketing/integrations/community-management/shares/posts-api?view=li-lms-2022-08&tabs=http#post-schema) for complete field details.\n\n| Field | Description |\n| --- | --- |\n| commentary | String |\n| contentCallToActionLabel | contentCallToActionLabel text |\n| contentLandingPage | URL of the landing page |\n| reshareContext |  |\n| lifecycleState |  |\n| adContext | \\*   dscName: Update the name of the sponsored content<br>\\*   dscStatus: Update the status of the sponsored content |",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "posts",
                ":shared ID",
                ":ugcPosts ID"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "key": "X-Restli-Protocol-Version",
                "value": "<string>",
                "description": ""
              },
              {
                "disabled": false,
                "key": "LinkedIn-Version",
                "value": "<string>",
                "description": ""
              },
              {
                "key": "Content-Type",
                "value": "*/*"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "<string>"
            }
          },
          "response": [
            {
              "id": "65fc46b1-f1db-4a2c-9654-ab73195704b2",
              "name": "Successful response",
              "originalRequest": {
                "url": {

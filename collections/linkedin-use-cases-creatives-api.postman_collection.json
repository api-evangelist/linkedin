          "id": "72599341-4145-419b-8cbf-f58795838cf6",
          "name": "LinkedIn Search for Creative",
          "request": {
            "name": "LinkedIn Search for Creative",
            "description": {
              "content": "You can search for creative content in order to get a collection of creatives matching your search parameters. The Creative API currently supports search by `creative id`, `campaign`, `account`, `content reference`, `intendedStatus`, `leadgenCreativeCallToActionDestinations` and test fields. The API supports finding creatives from multiple accounts. The values within each field are displayed with 'or' (ORed) and values across fields are displayed with 'and' (ANDed).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "creatives"
              ],
              "host": [
                "{{baseUrl}}"
              ],

        {
          "id": "3aa1c319-a4a5-4ad5-b00b-dde19f6ded44",
          "name": "LinkedIn Delete a Creative",
          "request": {
            "name": "LinkedIn Delete a Creative",
            "description": {
              "content": "A Creative can be deleted. Use DELETE method to delete a creative that meets one of the following conditions. To start the process of deleting other creative, update the status to `PENDING_DELETION`.\n\n\\*   It is in a DRAFT state.\n\\*   It is linked to a Campaign in a DRAFT state.\n\\*   It is a video ad creative and `processingState` is `PROCESSING_FAILED`.\n    \n\nThe header X-RestLi-Method must be included in the request and set to `DELETE`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "creatives",
                ":creative ID"
